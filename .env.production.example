# Production environment for deploy/compose.prod.yml (EAP-66).
#
#   cp .env.production.example .env.production      # then fill EVERY line below
#   chmod 600 .env.production
#
# .env.production is gitignored. This file names every variable and holds no values: a value
# here would be a value in git. Generate secrets with `openssl rand -base64 48` (or
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
#
# Variables the compose file fixes for you and you must NOT set here: DATABASE_URL,
# APP_DATABASE_URL, REDIS_URL, TEMPORAL_ADDRESS. They are built from the service names on the
# compose network and the two passwords below.

# --- the host --------------------------------------------------------------------------------
# The DNS name students will open. Caddy obtains the certificate for it; the A record must
# point at this VPS BEFORE the first `up`, or Let's Encrypt cannot validate.
DOMAIN=

# --- Postgres --------------------------------------------------------------------------------
# The owner role (`eap`): migrations, seeds, backups, scripts/ops_report.py. Temporal's own
# databases use it too.
POSTGRES_PASSWORD=
# The restricted application role (`eap_app`) the API and worker connect as, so RLS applies
# (ADR-002). Migration 0005 creates the role with THIS password on the first
# `alembic upgrade head` (EAP-38). To rotate later: ALTER ROLE eap_app PASSWORD '...', then
# change this and restart api + worker.
APP_DB_PASSWORD=

# --- the app ---------------------------------------------------------------------------------
# prod makes the checks in eap.core.config strict: JWT_SECRET must be set and not the dev
# one, GOOGLE_API_KEY must be set, CORS_ALLOW_ORIGINS must not contain localhost. JSON logs.
APP_ENV=prod
APP_NAME=eap
LOG_LEVEL=INFO

# Signs every access token. At least 32 bytes; a short one is brute-forceable from a single
# captured token, and whoever cracks it can mint a token for any tenant.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30

# JSON list of the origins the admin UI is served from. In this deployment the UI and the API
# share one origin behind Caddy, so this is exactly ["https://<DOMAIN>"]. The API refuses to
# start in prod with the localhost default (EAP-51) - set it, with the real domain, in quotes.
CORS_ALLOW_ORIGINS=

# --- limits ----------------------------------------------------------------------------------
# Requests per tenant per minute on the run endpoint (EAP-46). 0 disables.
RATE_LIMIT_RUNS_PER_MINUTE=60
# The calendar the daily token budget (EAP-64) and the ops windows (EAP-65) count days in.
# The budget itself is per tenant on the tenants row; seed_demo.py sets the colleges to
# 5,000,000 a day.
TOKEN_BUDGET_TIMEZONE=Asia/Kolkata
# Worst-case seconds for one agent run, and the worker's concurrency.
AGENT_RUN_TIMEOUT_SECONDS=60
TENANT_MAX_CONCURRENT_RUNS=4
WORKER_MAX_CONCURRENT_ACTIVITIES=20

# --- Temporal --------------------------------------------------------------------------------
# The queue name is a contract between the API and the worker; both read it from here.
TEMPORAL_TASK_QUEUE=eap-agent-runs

# --- models ----------------------------------------------------------------------------------
# Completions: gemini or anthropic. Embeddings are ALWAYS Gemini (Anthropic has no embeddings
# API), so GOOGLE_API_KEY is required whichever provider answers questions.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_MS=200
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=30

# Embeddings. EMBEDDING_DIMENSIONS is frozen into the vector column by migration 0007; do not
# change it without a migration and a re-embed.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=100

# Where per-tenant provider keys live (EAP-47). Only `env` exists; keys are then plaintext in
# this file (EAP-59, known limit). Per-tenant overrides, if a college brings its own key:
#   TENANT_<SLUG>_LLM_PROVIDER=
#   TENANT_<SLUG>_GOOGLE_API_KEY=
#   TENANT_<SLUG>_ANTHROPIC_API_KEY=
SECRET_BACKEND=env

# --- seeds -----------------------------------------------------------------------------------
# Password for the admin and demo student accounts scripts/seed_demo.py creates. Required in
# production: unset, the seed uses a published dev default. Per-student passwords come from
# scripts/seed_students.py and are written only to demo-docs/<tenant>/credentials.txt.
DEMO_PASSWORD=
