# Copy to .env — never commit .env
APP_ENV=dev
APP_NAME=eap
LOG_LEVEL=INFO

# Postgres (docker compose exposes 5432; "eap" db, user/password eap/eap)
DATABASE_URL=postgresql+asyncpg://eap:eap@localhost:5432/eap
# Redis
REDIS_URL=redis://localhost:6379/0

# LLM APIs (M2+)
GOOGLE_API_KEY=
# The running app uses the restricted role; migrations use DATABASE_URL (the owner).
# Migration 0005 creates eap_app with the password in THIS url (EAP-38), so set it before
# the first `alembic upgrade head`; unset, the dev default `eap_app` applies. To rotate
# later: ALTER ROLE eap_app PASSWORD '...' in Postgres, then change the url here.
APP_DATABASE_URL=postgresql+asyncpg://eap_app:eap_app@localhost:5432/eap

# --- Per-tenant provider keys (EAP-47) ---
# A tenant may bring their own provider and key; the platform key is the fallback.
# TENANT_ACME_LLM_PROVIDER=anthropic
# TENANT_ACME_ANTHROPIC_API_KEY=sk-ant-...
# TENANT_GLOBEX_GOOGLE_API_KEY=AIza...

# CORS (EAP-51): origins the admin UI is served from. JSON list. The dev default
# covers Vite; production MUST set this explicitly or the app refuses to boot.
# CORS_ALLOW_ORIGINS=["https://app.example.com"]

# Password for every user created by scripts/seed_demo.py. Unset means the dev-only
# default (demo-password-123). Set it before seeding anything reachable off your machine.
# DEMO_PASSWORD=
