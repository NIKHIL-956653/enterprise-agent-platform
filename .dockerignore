# Build context for Dockerfile and deploy/caddy.Dockerfile is the repository root. Keep the
# context small and keep anything secret or local out of every image layer.
.git
.github
.venv
venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
htmlcov
.coverage
.env
.env.*
!.env.example
!.env.production.example
demo-docs
dump.rdb
data
*.log
docs
tests
web/node_modules
web/dist
web/*.tsbuildinfo
